{
	"name": "@bhsd/common",
	"version": "4.1.0",
	"homepage": "https://github.com/bhsd-harry/common#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/common/issues"
	},
	"license": "MIT",
	"author": "Bhsd",
	"files": [
		"/dist/"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js"
	},
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"prepublishOnly": "npm run build",
		"build": "tsc && eslint --no-inline-config --no-config-lookup -c eslint.dist.js dist/*.js",
		"lint:ts": "tsc --noEmit && oxlint && eslint --cache .",
		"lint": "npm run lint:ts",
		"migrate": "oxlint-migrate",
		"test": "testUtil test/*.test.js"
	},
	"peerDependencies": {
		"culori": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"culori": {
			"optional": true
		}
	},
	"devDependencies": {
		"@bhsd/code-standard": "^5.1.0",
		"@bhsd/lezer-json": "^2.3.0",
		"@bhsd/test-util": "^3.3.0",
		"@oxlint/migrate": "^1.89.0",
		"@types/culori": "^4.0.1",
		"culori": "^4.0.2",
		"eslint": "^10.14.0",
		"oxlint": "^1.89.0",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": "^22.13.0 || >=24.11.0"
	}
}
